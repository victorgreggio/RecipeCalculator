@page "/custom-functions"

<PageTitle>Custom Functions - Recipe Calculator</PageTitle>

<div class="container-fluid mt-4">
    <h1 class="mb-4">Custom Functions</h1>
    
    <div class="alert alert-info">
        <strong>What are Custom Functions?</strong>
        <p class="mb-0">
            Custom functions are user-defined operations that extend the formula engine's capabilities. 
            They are implemented by extending the <code>BaseFunction</code> class and can be used in formulas 
            just like built-in functions.
        </p>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">GetNum1Func</h5>
                </div>
                <div class="card-body">
                    <h6>Description:</h6>
                    <p>A simple function that returns a constant number (1.0) with no parameters.</p>
                    
                    <h6>Parameters:</h6>
                    <p><code>None</code></p>
                    
                    <h6>Returns:</h6>
                    <p><code>Number: 1.0</code></p>
                    
                    <h6>Usage Example:</h6>
                    <pre class="bg-light p-3"><code>return GetNum1Func()</code></pre>
                    <p><strong>Result:</strong> 1</p>
                    
                    <h6>Source Code:</h6>
                    <pre class="bg-dark text-light p-3" style="font-size: 0.85em;"><code>public class GetNum1Func : BaseFunction
{
    public GetNum1Func() : base(nameof(GetNum1Func), 0)
    {
    }

    public override IValue Execute()
    {
        return new Value(1.0);
    }
}</code></pre>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">GetNum2Func</h5>
                </div>
                <div class="card-body">
                    <h6>Description:</h6>
                    <p>A simple function that returns a constant number (2.0) with no parameters.</p>
                    
                    <h6>Parameters:</h6>
                    <p><code>None</code></p>
                    
                    <h6>Returns:</h6>
                    <p><code>Number: 2.0</code></p>
                    
                    <h6>Usage Example:</h6>
                    <pre class="bg-light p-3"><code>return GetNum2Func()</code></pre>
                    <p><strong>Result:</strong> 2</p>
                    
                    <h6>Source Code:</h6>
                    <pre class="bg-dark text-light p-3" style="font-size: 0.85em;"><code>public class GetNum2Func : BaseFunction
{
